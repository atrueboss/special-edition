    ;;-*-Lisp-*-
    (in-package goal)

    ;; name: mod-custom-code.gc
    ;; name in dgo: mod-custom-code
    ;; dgos: TODO


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; What is this file for.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;

    #| This file contains function defenitions that are pre placed in the mod base,
    so if you place custom code inside of these functions, it will exectue based on
    the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
    to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
    an orb |#


    ;;;;;;;;;;;;;;;;;;;;;;;;;;
    ;; Begin function defintions.
    ;;;;;;;;;;;;;;;;;;;;;;;;;;

    (define *mod-hint-shown* #f)
    (define *mod-hint-active* #f)
    (define *mod-hint-grabbed* #f)
    (defun begin-game-mod-explanation-hint ()
      ;; Trigger hint when in prison for first time
      (when (and *target*
                (not *mod-hint-shown*)
                (= (-> (level-get-target-inside *level*) name) 'prison)
                (not (task-node-closed? (game-task-node begin-game-mod-explanation-hint-done)))
                (pause-allowed?)
                (not *scene-player*)
                )
        (set! *mod-hint-active* #t)
        (set! *mod-hint-shown* #t)
        )
      ;; Grab jak once active
      (when (and *mod-hint-active* *target* (not *mod-hint-grabbed*))
        (when (process-grab? *target* #f)
          (set! *mod-hint-grabbed* #t)
          )
        )
      ;; Draw text while active
      (when *mod-hint-active*
        (set-setting! 'play-hints #f 0.0 0)
        (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons start))
        (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons start))
        (hide-hud-quick (the-as symbol 'hud-health))
        (hide-hud-quick (the-as symbol 'hud-dark-eco-symbol))
        (hide-hud-quick (the-as symbol 'hud-map))
        (hide-hud-quick (the-as symbol 'hud-skill))
        (hide-hud-quick (the-as symbol 'hud-skullgem))
        (hide-hud-quick (the-as symbol 'hud-gun))
        (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id progress))
          (dma-buffer-add-gs-set-flusha buf
            (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
            (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 80 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.6)
            (pc-encode-utf8-string (string-format "Welcome to Jak II: Special Edition!") *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 100 0.0 (font-color default) (font-flags shadow kerning middle large))))
                  (set! (-> font-ctx scale) 0.5)
                  (pc-encode-utf8-string (string-format "by atrueboss") *pc-encoded-temp-string*)
                  (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
                  )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 145 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.5)
            (pc-encode-utf8-string (string-format "This mod features 3 extra missions") *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 160 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.5)
            (pc-encode-utf8-string (string-format "that you can access from the side") *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 175 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.5)
            (pc-encode-utf8-string (string-format "mission kiosks in three areas:") *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 190 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.5)
            (pc-encode-utf8-string (string-format "Water Slums, Central Plaza and Bazaar") *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 230 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.5)
            (pc-encode-utf8-string (string-format "The missions need to be unlocked by") *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 245 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.5)
            (pc-encode-utf8-string (string-format "playing through the game about halfway.") *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 260 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.5)
            (pc-encode-utf8-string (string-format "You can play the game to reach that point") *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 275 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.5)
            (pc-encode-utf8-string (string-format "or just skip ahead from here.") *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 320 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.6)
            (format (clear *temp-string*) "Press ~S and ~S to skip ahead"
              (lookup-text! *common-text* (text-id pad-l1) #f)
              (lookup-text! *common-text* (text-id pad-triangle) #f))
            (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 350 0.0 (font-color default) (font-flags shadow kerning middle large))))
            (set! (-> font-ctx scale) 0.6)
            (format (clear *temp-string*) "Press ~S and ~S to start normally"
              (lookup-text! *common-text* (text-id pad-l1) #f)
              (lookup-text! *common-text* (text-id pad-x) #f))
            (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
            (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
            )
          )
        ;; L1 + Δ skip ahead logic
        (when (and (cpad-hold? 0 l1) (cpad-pressed? 0 triangle))
          (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons confirm x))
          (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons confirm x))
          (when *mod-hint-grabbed*
            (process-release? *target*)
            (set! *mod-hint-grabbed* #f)
            )
          (task-node-close! (game-task-node city-protect-water-slums-resolution))
          (task-node-close! (game-task-node city-intercept-tanker-resolution))
          (send-event *target* 'continue (get-continue-by-name *game-info* "ctyslumc-start"))
          (remove-setting! 'play-hints)
          (hide-hud-quick #f)
          (set! *mod-hint-active* #f)
          (task-node-close! (game-task-node begin-game-mod-explanation-hint-done))
          )
        ;; L1 + X continue logic
        (when (and (cpad-hold? 0 l1) (cpad-pressed? 0 confirm))
          (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons confirm x))
          (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons confirm x))
          (when *mod-hint-grabbed*
            (process-release? *target*)
            (set! *mod-hint-grabbed* #f)
            )
          (remove-setting! 'play-hints)
          (hide-hud-quick #f)
          (set! *mod-hint-active* #f)
          (task-node-close! (game-task-node begin-game-mod-explanation-hint-done))
          )
      )
    (none)
    )

    (defun wider-view () ;; Set camera fov to 94.0 (way better imo)
      (set-setting-by-param *setting-control* 'fov #f (* 182.04445 94) 0) 
      )

    (define *hover-cam-hint-start* (the-as time-frame -1))
    (defun better-hover-cam ()
      ;; hover + square brings camera with you
      (when *target*
        (if (and (board-hovering?) (cpad-hold? 0 square))
            (set-setting-by-param *setting-control* 'slave-options 'clear 0 16)
            (remove-setting-by-arg0 *setting-control* 'slave-options)
            )
        )
      ;; Start timer on first hover
      (when (and *target*
                (board-hovering?)
                (not (task-node-closed? (game-task-node hover-cam-hint-done)))
                (= *hover-cam-hint-start* -1)
                )
        (set! *hover-cam-hint-start* (-> *display* real-clock frame-counter))
        )
      ;; Draw text while timer active
      (when (not (= *hover-cam-hint-start* -1))
        (cond
          ;; Still within 6 seconds — draw hint
          ((< (- (-> *display* real-clock frame-counter) *hover-cam-hint-start*) (seconds 6))
          (when (not *progress-process*)
            (set-setting! 'play-hints #f 0.0 0)
            (hide-hud-quick (the-as symbol 'hud-health))
            (hide-hud-quick (the-as symbol 'hud-dark-eco-symbol))
            (hide-hud-quick (the-as symbol 'hud-map))
            (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id progress))
              (dma-buffer-add-gs-set-flusha buf
                (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                )
              (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 310 0.0 (font-color default) (font-flags shadow kerning middle large))))
                (set! (-> font-ctx scale) 0.7)
                (format (clear *temp-string*) "While hovering, hold ~S to"
                  (lookup-text! *common-text* (text-id pad-square) #f))
                (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
                (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
                )
              (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 340 0.0 (font-color default) (font-flags shadow kerning middle large))))
                (set! (-> font-ctx scale) 0.7)
                (pc-encode-utf8-string (string-format "bring the camera with you") *pc-encoded-temp-string*)
                (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
                )
              )
            )
          )
          ;; 6 seconds elapsed — always clean up and close
          (else
            (remove-setting! 'play-hints)
            (hide-hud-quick #f)
            (format #t "closing hover-cam-hint-done, currently closed: ~A~%"
              (task-node-closed? (game-task-node hover-cam-hint-done)))
            (task-node-close! (game-task-node hover-cam-hint-done))
            (format #t "after close, closed: ~A~%"
              (task-node-closed? (game-task-node hover-cam-hint-done)))
            (set! *hover-cam-hint-start* -1)
            )
          )
        )
      (none)
      )

    (defun mod-override-init-position ((obj process-drawable) (arg0 entity-actor)) ;; Thanks barg :)
      (case (-> obj name) :comp name=
        (('burning-bush-13) ;; city-burning-bush-get-to-6 / burning-bush-markb-2
          (set-vector-meters! (-> arg0 extra trans) 416.67   8.40   422.77)  ;; in tanker attack area
          (set-vector! (-> arg0 quat)  0.00   0.99   0.00   -0.01))
        )
        (none)
      )

    (defun vanilla-region-hacks ()
      ;; == palcab
      (let ((r (region-lookup-by-id 386))) ;; 1/3 across palcab - stop this region from loading palshaft when going backwards which interrupts pal2boss
        (when r
          (set! (-> r on-enter) '(want-sound 'ctywide1 'palcab1 'palcab2))
          )
        )
      (let ((r (region-lookup-by-id 385))) ;; halfway across palcab - don't load throne if we are after the cutscene
        (when r
          (set! (-> r on-enter) '(if (task-closed? "palace-cable-resolution")
                                    (begin (want-load 'palcab 'palroof 'pal2boss))
                                    (begin (want-load 'palcab 'palroof 'throne))
                                    ))
          )
        )
      (let ((r (region-lookup-by-id 815))) ;; checkpoint "palcab-mid" - don't load throne if we are after the cutscene
        (when r
          (set! (-> r on-inside) '(if (task-closed? "palace-cable-resolution")
                                    (begin (want-load 'palcab 'palroof 'pal2boss) (want-display 'pal2boss 'display))
                                    (begin (want-load 'palcab 'palroof 'throne))
                                    ))
          )
        )
      ;; == palroof
      (let ((r (region-lookup-by-id 623))) ;; before palboss - don't load palboss if he's dead already 
        (when r
          (set! (-> r on-enter) '(if (task-closed? "palace-boss-resolution")
                                    (begin (want-sound 'ctywide1 'palcab1 'palcab2))
                                    (begin (want-sound 'palroof1 'palroof2 'palroof3) (want-load 'palroof 'palcab 'palboss))
                                    ))
          )
        )
      (let ((r (region-lookup-by-id 663))) ;; after 1st phase palboss, load/deload palcab/pal2cab 
        (when r
          (set! (-> r on-enter) '(begin (want-load 'palroof 'palboss 'pal2cab) (send-event "squid-2" 'plane 0)))
          (set! (-> r on-exit) '(want-load 'palroof 'palboss 'palcab))
          )
        )
      ;; == forresca 
      (let ((r (region-lookup-by-id 650))) ;; display ctysluma (ex-resca) if you go back
        (when r 
          (set! (-> r on-enter) '(begin (want-load 'forresca 'forrescb) (send-event "crimson-guard-hover-41" 'cue-chase))) 
          (set! (-> r on-exit) '(begin (want-load 'forresca 'ex-resca)))  
          )
        )
      (let ((r (region-lookup-by-id 658))) ;; display forrescb
        (when r 
          (set! (-> r on-enter) '(begin (want-display 'forrescb) (send-event "battle-55" 'trigger))) 
          )
        )
      ;; == mountain 
      (let ((r (region-lookup-by-id 610))) ;; load mincan if you take shortcut
        (when r 
          (set! (-> r on-exit) '(want-load 'mountain 'mincan))  
          )
        )
      (let ((r (region-lookup-by-id 608))) ;; load mtnext if you took shortcut
        (when r 
          (set! (-> r on-exit) '(begin (want-load 'mountain 'mtnext) (want-display 'mtnext 'display))) 
          )
        )
      )
      
    (defun custom-region-hacks () ;; not working perfectly, kinda buggy
      (custom-region 0
        (meters 756.31) (meters 11.57) (meters 226.99)
        (meters 10.0)   ;; height
        (meters 15.0)   ;; width
        (lambda () (script-eval '(begin (want-load 'forresca)))) ;; on-enter
        (lambda () (script-eval '(want-load 'forresca #f)))      ;; on-exit
        )
      )

    (defun door-hacks ()
    ;; == fortress
      (let ((door (entity-by-name "fort-entry-gate-17"))) ;; main entrance to fortress - lower notice distance to stop annoying unintended loads 
        (when door
          (set! (-> (the (pointer float) (res-lump-struct door 'distance pointer)) 0) (meters 10))
          )
        )
      (let ((door (entity-by-name "fort-entry-gate-4"))) ;; main exit of fordumpa - lower notice distance to stop annoying unintended loads 
        (when door                                       
          (set! (-> (the (pointer float) (res-lump-struct door 'distance pointer)) 0) (meters 5))
          )
        )
      (let ((door (entity-by-name "fort-entry-gate-7"))) ;; main exit of forresca - lower notice distance to stop annoying unintended loads 
        (when door                                       
          (set! (-> (the (pointer float) (res-lump-struct door 'distance pointer)) 0) (meters 5))
          )
        )
      )

    (defun bubble-hacks ()
      (cond ;; load ctywide if you turn out of fordumpa before entering all the way
         ((and (= (level-status *level* 'fordumpa) 'active)                 ;; if in this level 
               (in-bubble? (meters 762.22) (meters  15.25) (meters 227.04)  ;; location x y z 
                           (meters 10.0)                                    ;; bubble size
                 )    
            )
          (script-eval '(want-load 'ctysluma 'ctywide 'fordumpa))
          (script-eval '(want-display 'ctywide 'display))
          )
        )
      (cond ;; load ctywide if you turn out of forresca before entering all the way
         ((and (= (level-status *level* 'forresca) 'active)                 ;; if in this level 
               (in-bubble? (meters 762.22) (meters  15.25) (meters 227.04)  ;; location x y z 
                           (meters 10.0)                                    ;; bubble size
                 )    
            )
          (script-eval '(want-load 'ctysluma 'ctywide 'forresca))
          (script-eval '(want-display 'ctywide 'display))
          )
        )
      ;; == ex-resca
      (cond ;; display ex-resca when entering fortress
         ((and (= (level-status *level* 'ex-resca) 'loaded)             ;; if in this level            
               (in-bubble? (meters 749.41) (meters  14.51) (meters 226.62)  ;; location x y z 
                           (meters 50.0)                                    ;; bubble size
                 )    
            )
          (script-eval '(want-display 'ex-resca 'display))
          )
        )
      (cond ;; load ex-resca if you turn back on forresca path
         ((and (= (level-status *level* 'ex-resca) 'loaded)                 ;; if in this level 
               (in-bubble? (meters 682.02) (meters  20.61) (meters 236.28)  ;; location x y z 
                           (meters 40.0)                                    ;; bubble size
                 )    
            )
          (script-eval '(want-display 'ex-resca 'display))
          )
        )
      ;; == palroof 
      (cond ;; display palcab/pal2cab on palroof
         ((and (or (= (level-status *level* 'palcab) 'loaded)               ;; if in this level 
                   (= (level-status *level* 'pal2cab) 'loaded))             
               (in-bubble? (meters 263.35) (meters 409.43) (meters 526.81)  ;; location x y z 
                           (meters 80.0)                                    ;; bubble size
                 )    
            )
          (if (= (level-status *level* 'palcab) 'loaded)
              (script-eval '(want-display 'palcab 'display))
              (script-eval '(want-display 'pal2cab 'display))
            )
          )
        )
      (when *target*
        (logior! (-> *target* control root-prim prim-core collide-with) (collide-spec backgnd))
        )
      (cond ;; disable endlessfall event and deathplane collision to land on new pal2cab from palroof
         ((and (= (level-status *level* 'pal2cab) 'active)                       ;; if in this level 
               (task-closed? "fortress-save-friends-resolution")                 ;; if this task is closed
               (or  (in-bubble? (meters 269.39) (meters 401.29) (meters 537.85)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 273.13) (meters 401.29) (meters 542.44)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 275.87) (meters 401.29) (meters 547.19)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 280.87) (meters 401.29) (meters 544.99)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 277.72) (meters 401.29) (meters 539.48)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 275.61) (meters 401.29) (meters 533.52)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 280.90) (meters 401.29) (meters 528.12)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 286.57) (meters 401.29) (meters 534.16)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 291.15) (meters 401.29) (meters 538.51)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 298.12) (meters 401.29) (meters 536.40)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 296.74) (meters 401.29) (meters 530.60)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 293.42) (meters 401.29) (meters 524.76)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 288.70) (meters 401.29) (meters 520.11)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 285.86) (meters 401.29) (meters 541.49)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 307.98) (meters 401.29) (meters 533.25)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 305.18) (meters 401.29) (meters 527.77)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 302.90) (meters 401.29) (meters 522.45)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 300.36) (meters 401.29) (meters 516.15)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 295.75) (meters 401.29) (meters 509.96)  ;; location x y z 
                                (meters 14.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 303.15) (meters 401.29) (meters 502.20)  ;; location x y z 
                                (meters 25.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 307.33) (meters 401.29) (meters 510.57)  ;; location x y z 
                                (meters 25.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 312.09) (meters 401.29) (meters 516.90)  ;; location x y z 
                                (meters 25.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 317.52) (meters 401.29) (meters 525.11)  ;; location x y z 
                                (meters 25.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 321.28) (meters 401.29) (meters 531.01)  ;; location x y z 
                                (meters 25.0)                                    ;; bubble size
                      )
                )  
            )
          (script-eval '(setting-pers endlessfall mode #f))
          (logclear! (-> *target* control root-prim prim-core collide-with) (collide-spec backgnd))
          )
        )
      (cond ;; ignore invisible wall that leads to new palroof area
         ((and (= (level-status *level* 'palroof) 'active)                       ;; if in this level 
               (task-closed? "fortress-save-friends-resolution")                 ;; if this task is closed
               (or  (in-bubble? (meters 253.84) (meters 416.18) (meters 712.03)  ;; location x y z 
                                (meters 15.0)                                    ;; bubble size
                      )
                    (in-bubble? (meters 253.84) (meters 411.93) (meters 712.03)  ;; location x y z 
                                (meters 15.0)                                    ;; bubble size
                      )
                )  
            )
          (logclear! (-> *target* control root-prim prim-core collide-with) (collide-spec backgnd))
          )
        )
      )

    (defun custom-music-volume-manager ()
    "Run on every frame in mod-custom-code to constantly update music volume."
      (main-music-volume (the int (* 100.0 (-> *setting-control* user-current music-volume)))) 
      )

    (defun zero-volume? ()
    "Returns true if the volume of main music should be set to 0. This is a hack."
      (or (not (= *master-mode* 'game))
          (= (-> (level-get-target-inside *level*) name) 'title)
        )
      )

    (define *current-playing-custom-music-str* (new 'global 'string 2048 (the-as string #f)))
    (defun custom-music-player ()
      (cond
        ;; FORTSHAFT WIND AMBIENCE
        ((= (level-status *level* 'fortshaft) 'active)
        (when (not (string= *current-playing-custom-music-str* "fortshaft-amb.wav"))
          (stop-main-music)
          (play-main-music "fortshaft-amb.wav" (the int (* 50.0 (-> *setting-control* user-current music-volume))))
          (format (clear *current-playing-custom-music-str*) "fortshaft-amb.wav")
          )
        )
        ;; NOT IN ANY CUSTOM MUSIC LEVEL - stop if we were playing something
        (else
          (when (> (length *current-playing-custom-music-str*) 0)
            (stop-main-music)
            (format (clear *current-playing-custom-music-str*) "")
            )
          )
        )
      )

    (defun runs-every-frame ()
      (if *show-input-display* 
        (input-display-on)
        (input-display-off)
        )
      (when *debug-segment*
        (orb-placer-maintenance)
        )

      (begin-game-mod-explanation-hint)
      (better-hover-cam)
      (vanilla-region-hacks)
      ;; (custom-region-hacks)
      (door-hacks)
      (bubble-hacks)
      (custom-music-volume-manager)
      (custom-music-player)
      (none)
      )

    (defun runs-on-task-close ()

      (none)
      )

    (defun runs-on-jak-spawn ()
      ;; Code here runs every time jak spawns (loading a file new game or death)   
      (wider-view)
      (none)
      )

    (defun runs-on-jak-death ((death-event symbol))
      (case death-event
        (('dying)
          ;; Code here runs immediately every time jak dies, before any death animation or death cutscene
          
          )
        (('blackout)
          ;; Code here runs after jak dies (and any death cutscene finishes), during the blackout before he spawns

          )
        )
      
      (none)
      )


