;;-*-Lisp-*-
(in-package goal)

(define *ex-resca-airlock-data* (new 'static 'boxed-array :type airlock-data
              (static-airlock-data 
                :airlock-name "fort-entry-gate-69"
                :on-notice '(when (task-closed? "fortress-save-friends-resolution") '(forresca))
                :on-activate '(want-load 'forresca 'ex-resca)
                :on-enter '(want-display 'forresca 'display)
                :on-exit '(want-sound 'ctywide1 'forresc1 'forresc2)
                :on-cross #f
                :on-inside #f
                :on-deactivate #f
                )
              (static-airlock-data 
                :airlock-name "com-airlock-outer-69"
                :on-notice '(when (task-closed? "fortress-save-friends-resolution") '(fortshaft))
                :on-activate '(want-load 'fortshaft 'ex-resca #f)
                :on-enter '(begin (want-display 'fortshaft 'display) (want-sound 'ctywide1 'ctywide2 'palcab1))
                :on-exit '(want-display 'fortshaft #f)
                :on-cross #f
                :on-inside #f
                :on-deactivate '(begin (want-load 'forresca 'ex-resca #f) (want-sound 'ctywide1 'ctywide2 'palcab1))
                )
              )
  )