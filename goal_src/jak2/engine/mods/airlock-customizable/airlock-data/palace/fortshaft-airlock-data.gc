;;-*-Lisp-*-
(in-package goal)

(define *fortshaft-airlock-data* (new 'static 'boxed-array :type airlock-data
              (static-airlock-data 
                :airlock-name "com-airlock-inner-69"
                :on-notice '(when (task-closed? "fortress-save-friends-resolution") '(ex-resca))
                :on-activate '(want-load 'ex-resca 'fortshaft)
                :on-enter '(want-display 'ex-resca 'display)
                :on-exit '(want-display 'ex-resca #f)
                :on-cross #f
                :on-inside #f
                :on-deactivate #f
                )
              (static-airlock-data 
                :airlock-name "com-airlock-inner-70"
                :on-notice '(when (task-closed? "fortress-save-friends-resolution") '(pal2cab))
                :on-activate '(want-load 'pal2cab 'palroof 'fortshaft)
                :on-enter '(begin (want-display 'pal2cab 'display) (want-display 'palroof 'display))
                :on-exit '(begin (want-display 'pal2cab #f) (want-display 'palroof #f))
                :on-cross '(want-vis 'palroof)
                :on-inside #f
                :on-deactivate #f
                )
              )
  )